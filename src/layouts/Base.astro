---
// One layout for all pages. It rebuilds the original table layout exactly:
//   rows 1-2  logo + menu          (from src/data/menu.json)
//   middle    the page itself      (from src/page-content/<slug>.html)
//   bottom    bar + footer + spacer row
import pages from '../data/pages.json';
import menu from '../data/menu.json';

interface Props { slug: keyof typeof pages }
const { slug } = Astro.props;
const page = pages[slug];

const bodies = import.meta.glob('../page-content/*.html', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;
const body = bodies[`../page-content/${slug}.html`];
if (!body) throw new Error(`src/page-content/${slug}.html is missing`);

const isCurrent = (href: string) => href === page.href;
---
<html lang="nl">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1" />
	<title>{page.title}</title>
	{page.description && <meta name="description" content={page.description} />}
	{page.keywords && <meta name="keywords" content={page.keywords} />}
	<meta name="robots" content="index, follow" />
	<link href="stylesheet.css" rel="stylesheet" type="text/css" />
	<link href="mobile.css" rel="stylesheet" type="text/css" />
</head>
<body bgcolor="#FFFFFF" class={`page-${slug}`}>
<header id="m-head">
	<a href="index.html"><img src="afbeeldingen/header-mobiel.png" width="470" height="176" alt="Shiatsu Leiden - de weg naar balans" /></a>
	<nav>{menu.map((m) => isCurrent(m.href) ? <span>{m.label}</span> : <a href={m.href}>{m.label}</a>)}</nav>
</header>
<table width="753" height="100%" border="0" align="center" cellpadding="0" cellspacing="0" id="Tabel_01">
	<tr>
		<td colspan="2" class="sh_logo">&nbsp;</td>
		<td colspan="3" class="tophl">&nbsp;</td>
		<td class="sp"><img src="afbeeldingen/spacer.gif" width="1" height="79" alt="" /></td>
	</tr>
	<tr>
		<td colspan="3" class="slogan"></td>
		<td colspan="2" class="navmenu">{menu.map((m, i) => (
			<Fragment>{i > 0 && ' | '}{isCurrent(m.href) ? m.label : <a href={m.href}>{m.label}</a>}</Fragment>
		))} </td>
		<td class="sp"><img src="afbeeldingen/spacer.gif" width="1" height="31" alt="" /></td>
	</tr>
	<Fragment set:html={body} />
	<tr>
		<td colspan="5" class="baronder"></td>
		<td class="sp"><img src="afbeeldingen/spacer.gif" width="1" height="6" alt="" /></td>
	</tr>
	<tr>
		<td colspan="5" class="txt-footer">&copy; 2025 - All rights reserved{menu.map((m) => (
			<Fragment>{' | '}{isCurrent(m.href) ? m.footer : <a href={m.href}>{m.footer}</a>}</Fragment>
		))}| <a href="Privacy document RBCZ.pdf" target="_blank">Privacy</a></td>
		<td class="sp"><img src="afbeeldingen/spacer.gif" width="1" height="37" alt="" /></td>
	</tr>
	<tr class="sp-row">
		<td><img src="afbeeldingen/spacer.gif" width="318" height="1" alt="" /></td>
		<td><img src="afbeeldingen/spacer.gif" width="60" height="1" alt="" /></td>
		<td><img src="afbeeldingen/spacer.gif" width="108" height="1" alt="" /></td>
		<td><img src="afbeeldingen/spacer.gif" width="96" height="1" alt="" /></td>
		<td><img src="afbeeldingen/spacer.gif" width="170" height="1" alt="" /></td>
		<td></td>
	</tr>
</table>
</body>
</html>
